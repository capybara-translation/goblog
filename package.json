{
  "name": "goblog",
  "version": "1.0.0",
  "private": true,
  "description": "Tailwind CSS build for public pages",
  "scripts": {
    "build:css": "tailwindcss -c internal/view/tailwind.config.js -i internal/view/input.css -o internal/view/static/tailwind.css --minify",
    "watch:css": "tailwindcss -c internal/view/tailwind.config.js -i internal/view/input.css -o internal/view/static/tailwind.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.0"
  }
}
