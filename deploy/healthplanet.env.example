# Health Planet integration settings — single source for BOTH the goblog
# server (admin OAuth flow; loaded via EnvironmentFile=- in goblog.service)
# and the hpsync daily sync (goblog-hpsync.service).
# Copy to /etc/goblog/healthplanet.env, chmod 600, chown goblog:goblog.
#
# Register a *web application* at https://www.healthplanet.jp/ with your
# blog's domain; the redirect URI used by the admin panel is
# {BASE_URL}/admin/healthplanet/success.
HEALTHPLANET_ENABLED=true
HEALTHPLANET_CLIENT_ID=your-client-id
HEALTHPLANET_CLIENT_SECRET=your-client-secret

# Same DB the goblog service uses.
DATABASE_PATH=/var/lib/goblog/goblog.db

# --- Optional: CloudWatch dead-man's-switch monitoring ---
# Used by hpsync-run.sh (wrapper). Leave unset to skip metric publishing.
# NOTE: only set up the alarm when the integration is enabled — a disabled
# integration still exits 0 and would report healthy.
# The IAM user needs cloudwatch:PutMetricData restricted to this namespace
# (same pattern as the backup user, see docs/BACKUP.md).
#CW_NAMESPACE=Goblog/HPSync
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_DEFAULT_REGION=ap-northeast-1
