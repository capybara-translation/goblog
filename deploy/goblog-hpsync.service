[Unit]
Description=Sync weight and blood pressure from Health Planet into goblog DB
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=goblog
Group=goblog
WorkingDirectory=/opt/goblog

# HEALTHPLANET_ENABLED / _CLIENT_ID / _CLIENT_SECRET / DATABASE_PATH.
# chmod 600, owned by goblog. See deploy/healthplanet.env.example.
# The leading dash makes the file optional: if it does not exist systemd
# ignores the missing file rather than hard-failing the unit. This is safe
# because hpsync itself exits 0 when HEALTHPLANET_ENABLED is unset/false,
# so an enabled timer without the env file costs nothing.
EnvironmentFile=-/etc/goblog/healthplanet.env

# ProtectHome=true hides the real home; point HOME at the PrivateTmp dir so the
# AWS CLI (used by the monitoring wrapper) has a writable, private HOME.
Environment=HOME=/tmp

ExecStart=/opt/goblog/bin/hpsync run
# For CloudWatch monitoring, switch to the wrapper instead:
#ExecStart=/opt/goblog/bin/hpsync-run.sh

# Security hardening (mirrors goblog-backup.service). Unlike the backup,
# hpsync writes to the DB, so its directory must be writable.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/goblog

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=goblog-hpsync
