# goblog DB backup configuration.
#
# Install as /etc/goblog/backup.env, owned by goblog, mode 0600:
#   sudo install -D -o goblog -g goblog -m 600 deploy/backup.env.example /etc/goblog/backup.env
#   sudo nano /etc/goblog/backup.env   # fill in real values
#
# This file holds long-lived AWS credentials, so it must NOT be world-readable
# and must NOT be committed with real values.

# --- backup target ---
S3_BUCKET=my-goblog-backups
S3_PREFIX=goblog
DB_PATH=/var/lib/goblog/goblog.db

# --- monitoring (CloudWatch heartbeat; defaults are fine) ---
# The script emits BackupSuccess=1 on success / 0 on failure to this metric.
# A CloudWatch Alarm (TreatMissingData=breaching) -> SNS turns both failures and
# "never ran" into an alert. See docs/BACKUP.md for the alarm + SNS setup.
METRIC_NAMESPACE=Goblog/Backup
METRIC_NAME=BackupSuccess

# --- AWS credentials for an IAM user scoped to s3:PutObject (this bucket) and
#     cloudwatch:PutMetricData (this namespace) only. ---
# (Lightsail has no IAM instance roles, so static keys are required.)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-1
