# Server settings
PORT=8080

# Security settings
SECURE_COOKIE=false
PASSWORD_POLICY=NONE

# Database settings
DATABASE_PATH=data/goblog.db

# Site settings
BLOG_TITLE=goblog
BASE_URL=http://localhost:8080
TZ=Asia/Tokyo

# Trusted proxy IPs/CIDRs (comma-separated, for X-Forwarded-For support)
# Set this when running behind a reverse proxy (e.g., nginx)
# TRUSTED_PROXIES=127.0.0.1

# Upload settings
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE=5242880

# Production environment example (uncomment and modify as needed)
# PORT=3000
# SECURE_COOKIE=true
# PASSWORD_POLICY=STRONG
# TRUSTED_PROXIES=127.0.0.1
# DATABASE_PATH=/var/lib/goblog/production.db
# BLOG_TITLE=My Awesome Blog
# BASE_URL=https://example.com
# UPLOAD_DIR=/var/lib/goblog/uploads
# MAX_UPLOAD_SIZE=10485760
