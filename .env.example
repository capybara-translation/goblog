# Server settings
PORT=8080

# Security settings
SECURE_COOKIE=false
PASSWORD_POLICY=NONE

# Database settings
DATABASE_PATH=data/goblog.db

# Site settings
BLOG_TITLE=goblog
BASE_URL=http://localhost:8080
TZ=Asia/Tokyo

# Trusted proxy IPs/CIDRs (comma-separated, for X-Forwarded-For support)
# Set this when running behind a reverse proxy (e.g., nginx)
# TRUSTED_PROXIES=127.0.0.1

# Upload settings
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE=5242880

# Pagination settings
# Number of posts per page on the home (/) and tag (/tags/{tag}) listings
# Valid range: 1-100. Values outside this range or unparseable values
# silently fall back to the default (20).
POSTS_PER_PAGE=20

# Session settings
# How long an authenticated admin session remains valid. Accepts Go-style
# duration strings ("24h", "30m", "168h"). A unit is required: values
# like "1" or "24" (no unit) are unparseable and fall back to the default
# (24h). Parseable values below 1m (e.g. "30s", "500ms") are caught by the
# minimum-duration floor and also fall back. Typical operational values
# are in the range of several hours to a few weeks. The login cookie's
# MaxAge is derived from this value so cookie and session expire together.
#
# Note: changing SESSION_TTL only affects sessions issued AFTER the server
# restarts with the new value. Sessions already in the in-memory store keep
# the TTL they were issued with. To force immediate logout for everyone
# (e.g. on suspected credential leak), restart the server (the store is
# in-memory and is wiped on restart).
SESSION_TTL=24h

# Production environment example (uncomment and modify as needed)
# PORT=3000
# SECURE_COOKIE=true
# PASSWORD_POLICY=STRONG
# TRUSTED_PROXIES=127.0.0.1
# DATABASE_PATH=/var/lib/goblog/production.db
# BLOG_TITLE=My Awesome Blog
# BASE_URL=https://example.com
# UPLOAD_DIR=/var/lib/goblog/uploads
# MAX_UPLOAD_SIZE=10485760
